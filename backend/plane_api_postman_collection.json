{
  "info": {
    "name": "Plane API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "planeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "code",
      "value": "",
      "type": "string"
    },
    {
      "key": "airlineId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Plane",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/planes",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "planes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"ABC123\",\n  \"manifacturer\": \"Boeing\",\n  \"model\": \"737\",\n  \"seats\": 180\n}"
        }
      }
    },
    {
      "name": "Get All Planes",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/planes",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "planes"
          ]
        }
      }
    },
    {
      "name": "Get Plane By ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/planes/{{planeId}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "planes",
            "{{planeId}}"
          ]
        }
      }
    },
    {
      "name": "Get Plane By Code",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/planes/code/{{code}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "planes",
            "code",
            "{{code}}"
          ]
        }
      }
    },
    {
      "name": "Get Planes By Airline",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/planes/airline/{{airlineId}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "planes",
            "airline",
            "{{airlineId}}"
          ]
        }
      }
    }
  ]
}