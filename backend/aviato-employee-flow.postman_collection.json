{
  "info": {
    "name": "Aviato - Employee Invitation Flow",
    "_postman_id": "12345678-abcd-efgh-ijkl-1234567890ab",
    "description": "Test flow: Create user, add to airline, list employees",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register New User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Test Employee\", \"email\": \"employee@example.com\", \"password\": \"password123\"}"
        },
        "url": {
          "raw": "http://localhost:3000/api/users/register",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "users",
            "register"
          ]
        }
      }
    },
    {
      "name": "Invite Employee to Airline",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"userId\": \"{{new_user_id}}\", \"airlineId\": \"{{airline_id}}\"}"
        },
        "url": {
          "raw": "http://localhost:3000/api/airlines/invite",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "airlines",
            "invite"
          ]
        }
      }
    },
    {
      "name": "Get Airline Employees",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "url": {
          "raw": "http://localhost:3000/api/airlines/{{airline_id}}",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "airlines",
            "{{airline_id}}"
          ]
        }
      }
    }
  ]
}