{
  "info": {
    "name": "Aviato Airline Employee API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get all employees (admin only)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{TOKEN_ADMIN}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:5000/api/airlines/employees/all",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "airlines",
            "employees",
            "all"
          ]
        }
      }
    },
    {
      "name": "Get employees of a single airline (admin or employee)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{TOKEN}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:5000/api/airlines/employees/:airlineId",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "airlines",
            "employees",
            ":airlineId"
          ]
        }
      }
    }
  ]
}