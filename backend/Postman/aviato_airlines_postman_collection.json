{
    "info": {
        "name": "Aviato - Airlines",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Create Airline",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"name\": \"Volare Airlines\",\n    \"code\": \"VL123\"\n}"
                },
                "url": {
                    "raw": "{{base_url}}/api/airlines",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "airlines"
                    ]
                }
            }
        },
        {
            "name": "Get All Airlines",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{base_url}}/api/airlines",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "airlines"
                    ]
                }
            }
        },
        {
            "name": "Get Airline By ID",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{base_url}}/api/airlines/:id",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "airlines",
                        ":id"
                    ]
                }
            }
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:3000"
        },
        {
            "key": "token",
            "value": ""
        }
    ]
}