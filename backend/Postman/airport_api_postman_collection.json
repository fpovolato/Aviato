{
  "info": {
    "name": "Airport API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "airportId",
      "value": "",
      "type": "string"
    },
    {
      "key": "iata",
      "value": "",
      "type": "string"
    },
    {
      "key": "icao",
      "value": "",
      "type": "string"
    },
    {
      "key": "country",
      "value": "",
      "type": "string"
    },
    {
      "key": "city",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Airport",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/airports",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "airports"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"airportId\": 1,\n  \"name\": \"Sample Airport\",\n  \"city\": \"Sample City\",\n  \"country\": \"Sample Country\",\n  \"iata\": \"SPX\",\n  \"icao\": \"SPXX\",\n  \"latitude\": 12.345678,\n  \"longitude\": 98.765432,\n  \"altitude\": 500,\n  \"timezone\": 2,\n  \"dst\": \"E\",\n  \"tzDatabaseTimezone\": \"Europe/Rome\",\n  \"type\": \"airport\",\n  \"source\": \"OurAirports\"\n}"
        }
      }
    },
    {
      "name": "Bulk Create Airports",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/airports/bulk",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "airports",
            "bulk"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "[\n  {\n    \"airportId\": 2,\n    \"name\": \"Another Airport\",\n    \"city\": \"Another City\",\n    \"country\": \"Another Country\",\n    \"iata\": \"ANR\",\n    \"icao\": \"ANRR\",\n    \"latitude\": 23.456789,\n    \"longitude\": 87.654321,\n    \"altitude\": 1000,\n    \"timezone\": -5,\n    \"dst\": \"N\",\n    \"tzDatabaseTimezone\": \"America/New_York\",\n    \"type\": \"airport\",\n    \"source\": \"OurAirports\"\n  },\n  {\n    \"airportId\": 3,\n    \"name\": \"Third Airport\",\n    \"city\": \"Third City\",\n    \"country\": \"Third Country\",\n    \"iata\": null,\n    \"icao\": null,\n    \"latitude\": -1.234567,\n    \"longitude\": 45.678901,\n    \"altitude\": 1500,\n    \"timezone\": 5.5,\n    \"dst\": \"O\",\n    \"tzDatabaseTimezone\": \"Asia/Kolkata\",\n    \"type\": \"airport\",\n    \"source\": \"OurAirports\"\n  }\n]"
        }
      }
    },
    {
      "name": "Get All Airports",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/airports",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "airports"
          ]
        }
      }
    },
    {
      "name": "Get Airports By IATA",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/airports/iata/{{iata}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "airports",
            "iata",
            "{{iata}}"
          ]
        }
      }
    },
    {
      "name": "Get Airports By ICAO",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/airports/icao/{{icao}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "airports",
            "icao",
            "{{icao}}"
          ]
        }
      }
    },
    {
      "name": "Get Airports By Country",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/airports/country/{{country}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "airports",
            "country",
            "{{country}}"
          ]
        }
      }
    },
    {
      "name": "Get Airports By City",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/airports/city/{{city}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "airports",
            "city",
            "{{city}}"
          ]
        }
      }
    },
    {
      "name": "Get Airport By ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/airports/{{airportId}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "airports",
            "{{airportId}}"
          ]
        }
      }
    },
    {
      "name": "Update Airport",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/airports/{{airportId}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "airports",
            "{{airportId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated Airport Name\",\n  \"city\": \"Updated City\"\n}"
        }
      }
    },
    {
      "name": "Delete Airport",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/airports/{{airportId}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "airports",
            "{{airportId}}"
          ]
        }
      }
    }
  ]
}