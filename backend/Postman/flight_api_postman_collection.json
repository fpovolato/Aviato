{
  "info": {
    "name": "Flight API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "flightId",
      "value": "",
      "type": "string"
    },
    {
      "key": "airlineId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Flight",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/flights",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "flights"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"flightNumber\": \"FL123\",\n  \"departureAirport\": \"64e2b1a5c9f1a2d3e4f56789\",\n  \"arrivalAirport\": \"64f3c2d6e7f8a9b0c1d23456\",\n  \"departureDate\": \"2025-06-01T09:00:00Z\",\n  \"arrivalDate\": \"2025-06-01T13:30:00Z\",\n  \"airline\": \"681c7e80b58481919453333719e6493d\",\n  \"plane\": \"64a65f9b8e1a013456789abc\",\n  \"status\": \"scheduled\",\n  \"price\": 150.0,\n  \"firstClassPrice\": 300.0,\n  \"additionalLuggagePrice\": 20.0\n}"
        }
      }
    },
    {
      "name": "Get All Flights",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/flights",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "flights"
          ]
        }
      }
    },
    {
      "name": "Get Flight By ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/flights/{{flightId}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "flights",
            "{{flightId}}"
          ]
        }
      }
    },
    {
      "name": "Get Flights By Airline",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/flights/airline/{{airlineId}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "flights",
            "airline",
            "{{airlineId}}"
          ]
        }
      }
    },
    {
      "name": "Update Flight",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/flights/{{flightId}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "flights",
            "{{flightId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"delayed\",\n  \"price\": 160.0\n}"
        }
      }
    },
    {
      "name": "Delete Flight",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/flights/{{flightId}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "flights",
            "{{flightId}}"
          ]
        }
      }
    }
  ]
}